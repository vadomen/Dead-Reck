            "state" : "translated",
            "value" : "FuGPS"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DriveLogger"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS connects to your car's OBD-II Bluetooth adapter to read its speed and engine data, so it can keep estimating your position when GPS is jammed. If you record a drive, this data is saved in the recording on your phone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS підключається до Bluetooth-адаптера OBD-II у вашому авто, щоб зчитувати швидкість і дані двигуна й продовжувати визначати позицію, коли GPS глушать. Якщо ви записуєте поїздку, ці дані зберігаються в записі на вашому телефоні."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS uses your location to show where you are and to keep estimating your position when GPS is jammed, also with the screen locked while you drive, and to pick the road map for your area. If you record a drive, your route is saved in the recording on your phone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS використовує вашу геолокацію, щоб показувати, де ви перебуваєте, продовжувати визначати позицію, коли GPS глушать (також із заблокованим екраном під час руху), і вибирати карту доріг для вашого району. Якщо ви записуєте поїздку, ваш маршрут зберігається в записі на вашому телефоні."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS records barometric altitude changes when you record a test drive; it stays in the recording on your phone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FuGPS записує зміни висоти за барометром, коли ви записуєте тестову поїздку; дані лишаються в записі на вашому телефоні."
          }
        }
      }
    }
  },
  "version" : "1.0"
}