      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зʼєднання закрилося під час очікування."
          }
        }
      }
    },
    "The demo drive is running. Stop it to record." : {
      "localizations" : {
