  "strings" : {
    "%@ (%@) will be permanently deleted. This cannot be undone." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) буде видалено назавжди. Цю дію не можна скасувати."
