    "%@, ODbL 1.0. Demo drive map data: OSM data of 2026-10-08 (Geofabrik extract), bundled in the app." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ODbL 1.0. Дані карти демо-поїздки: дані OSM від 2026-10-08 (витяг Geofabrik), вбудовані в застосунок."
          }
        }
      }
    },
    "%@, larger than the %@ limit" : {
      "comment" : "Settings → Maps, a download/install/remove failure reason after «Failed: » or «Could not remove …: » (lower-case fragment). PackFailure.resource, App/Sources/Navigation/RoadPackInstaller.swift. %1$@: the file's size, %2$@: the limit; formatted sizes (\"150 MB\").",
