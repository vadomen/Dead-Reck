<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hand-maintained: XcodeGen does NOT generate this file, it only points the
  target at it via INFOPLIST_FILE. Edit it directly; `xcodegen generate` will
  leave it alone.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FuGPS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DriveLogger</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Encryption is only HTTPS through URLSession plus SHA-256 file hashes
	     (CryptoKit, integrity only): exempt, so App Store Connect does not ask
	     the export-compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Permission purpose strings. Shown verbatim in the system prompt, so
	     they tell a driver in plain words what each one is for rather than
	     naming an API. No Always location: nothing requests it; the
	     background activity session keeps When In Use working with the
	     screen locked (D7 revised), so there is no Always purpose string. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>FuGPS connects to your car's OBD-II Bluetooth adapter to read its speed and engine data, so it can keep estimating your position when GPS is jammed. If you record a drive, this data is saved in the recording on your phone.</string>
	<key>NSMotionUsageDescription</key>
	<string>FuGPS uses your phone's motion sensors to follow the car's turns, braking and acceleration, so it can keep estimating your position when GPS is jammed. If you record a drive, this data is saved in the recording on your phone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FuGPS uses your location to show where you are and to keep estimating your position when GPS is jammed, also with the screen locked while you drive, and to pick the road map for your area. If you record a drive, your route is saved in the recording on your phone.</string>

	<!-- Record and Navigate have to survive the screen locking mid-drive
	     (D7 revised): location keeps the GNSS fixes and the estimate running,
	     bluetooth-central keeps the OBD link alive. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>

	<!-- Together these put the Documents directory in the Files app, so a
	     recorded drive can be copied off the phone without Xcode. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only: the phone is in a fixed mount and rotation would change
	     the device reference frame mid-recording. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
