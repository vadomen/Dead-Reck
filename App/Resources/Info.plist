<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hand-maintained: XcodeGen does NOT generate this file, it only points the
  target at it via INFOPLIST_FILE. Edit it directly; `xcodegen generate` will
  leave it alone.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DriveLogger</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DriveLogger</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Permission purpose strings. Shown verbatim in the system prompt, so
	     they say what is recorded and why rather than naming an API. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DriveLogger connects to your car's OBD-II adapter over Bluetooth to record speed and engine data for dead-reckoning research.</string>
	<key>NSMotionUsageDescription</key>
	<string>DriveLogger records accelerometer and gyroscope data while you drive so your journey can be reconstructed for dead-reckoning research.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DriveLogger records your location while you drive to provide a reference track for dead-reckoning research.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DriveLogger records your location for the whole drive, including when the screen is off, so the reference track for dead-reckoning research has no gaps.</string>

	<!-- Recording has to survive the screen locking mid-drive: location keeps
	     the GNSS track running and bluetooth-central keeps the OBD link alive. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>

	<!-- Together these put the Documents directory in the Files app, so a
	     recorded drive can be copied off the phone without Xcode. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only: the phone is in a fixed mount and rotation would change
	     the device reference frame mid-recording. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
