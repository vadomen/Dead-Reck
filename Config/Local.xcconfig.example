// Copy to Config/Local.xcconfig (git-ignored) and fill in your own values.
//
//     cp Config/Local.xcconfig.example Config/Local.xcconfig
//
// Needed only to build and run on a physical iPhone. Simulator builds and
// `swift test` work without this file — Config/Signing.xcconfig includes it
// optionally, so its absence is not an error.

// Your 10-character Apple Developer Team ID. Find it at
// https://developer.apple.com/account under Membership details.
DEVELOPMENT_TEAM = ABCDE12345

// The App Store identifier; Config/Signing.xcconfig already sets it, so this line
// only matters if you build under your own identifier (use a prefix you control).
// Changing it makes iOS treat the app as a different install: the old app and its
// recordings stay on the phone as a separate app, so export recordings from it
// first if you mean to delete it.
PRODUCT_BUNDLE_IDENTIFIER = com.vadomen.fugps
