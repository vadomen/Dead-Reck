{
  "permissions": {
    "additionalDirectories": [
      "../dead-reck-mutants"
    ],
    "allow": [
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift run *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer swift build *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer swift test *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer swift run *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun simctl list*)",
      "Bash(xcodegen generate *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl list*)",
      "Bash(xcrun devicectl list devices*)",
      "Bash(jq *)",
      "Bash(scripts/push_packs.sh --dry-run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch -r*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --merged*)",
      "Bash(git branch -d *)",
      "Bash(git worktree add ../dead-reck-*)",
      "Bash(git worktree add --detach ../dead-reck-mutants HEAD)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove ../dead-reck-*)",
      "Bash(git worktree prune*)",
      "Bash(git -C ../dead-reck-mutants checkout --detach -f *)",
      "Bash(git -C ../dead-reck-mutants checkout -f -- .)",
      "Bash(git -C ../dead-reck-mutants diff *)",
      "Bash(git -C ../dead-reck-mutants status *)"
    ],
    "ask": [
      "Bash(scripts/push_packs.sh)",
      "Bash(scripts/push_packs.sh --force*)",
      "Bash(scripts/push_packs.sh --device*)",
      "Bash(./scripts/push_packs.sh*)",
      "Bash(bash scripts/push_packs.sh*)",
      "Bash(sh scripts/push_packs.sh*)",
      "Bash(site/publish_packs.sh*)",
      "Bash(./site/publish_packs.sh*)",
      "Bash(bash site/publish_packs.sh*)",
      "Bash(sh site/publish_packs.sh*)",
      "Bash(wrangler*)",
      "Bash(npx wrangler*)",
      "Bash(npx -y wrangler*)",
      "Bash(npx --yes wrangler*)",
      "Bash(xcodebuild *platform=iOS,*)",
      "Bash(xcodebuild *-destination id=*)",
      "Bash(xcodebuild *-destination 'id=*)",
      "Bash(xcodebuild *-destination \"id=*)",
      "Bash(xcrun devicectl device *)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git stash drop*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove ../dead-reck-mutants*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add * -f*)",
      "Bash(git add * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout * -- *)",
      "Bash(git restore*)",
      "Bash(git switch -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git -C ../dead-reck-mutants/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
